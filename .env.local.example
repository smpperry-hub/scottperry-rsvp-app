NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of the only emails allowed to sign in to /dashboard.
# These users must already exist in Supabase Auth (create them manually in
# the dashboard - Authentication > Users > Add user) since magic-link sign-up
# is disabled for everyone else.
HOST_ALLOWED_EMAILS=host1@example.com,host2@example.com
