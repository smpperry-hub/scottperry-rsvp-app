NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of the only emails allowed to sign in to /dashboard.
# These users must already exist in Supabase Auth (create them manually in
# the dashboard - Authentication > Users > Add user) since magic-link sign-up
# is disabled for everyone else.
HOST_ALLOWED_EMAILS=host1@example.com,host2@example.com

# Which form the root URL (/) shows. "save_the_date" or "formal_invite".
# /save-the-date and /rsvp always work regardless of this setting - this
# only controls what "/" points to. Flip it (and redeploy) when you're
# ready to send Formal Invites.
ACTIVE_RSVP_TYPE=save_the_date
